# Зависимости ставятся в отдельный слой раньше кода: правка кода не заставляет
# тянуть их заново, пока не менялись requirements.txt или pyproject.toml.
FROM python:3.12-slim AS build
WORKDIR /app
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
COPY requirements*.txt pyproject.toml* ./
RUN python -m venv /venv \
 && /venv/bin/pip install --no-cache-dir --upgrade pip \
 && if [ -f requirements.txt ]; then /venv/bin/pip install --no-cache-dir -r requirements.txt; fi
COPY . .
RUN if [ -f pyproject.toml ]; then /venv/bin/pip install --no-cache-dir .; fi

FROM python:3.12-slim
WORKDIR /app
# Виртуальное окружение переносится целиком: в финальном образе нет ни pip,
# ни заголовков сборки, только сам интерпретатор и установленные пакеты.
ENV PATH="/venv/bin:$PATH" PYTHONUNBUFFERED=1
COPY --from=build /venv /venv
COPY . .
EXPOSE 8000
# Команда запуска зависит от фреймворка и структуры проекта — поправьте под свой.
# Для FastAPI это обычно uvicorn, для Django — gunicorn с wsgi-модулем.
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
