FROM python:3.12-slim AS build
WORKDIR /app
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN python -m pip install --no-cache-dir poetry
# Ставим зависимости в системный python образа, а не в отдельное окружение poetry:
# в контейнере изоляция уже обеспечена самим контейнером.
ENV POETRY_VIRTUALENVS_CREATE=false
COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-interaction --no-root --without dev
COPY . .
RUN poetry install --no-interaction --only-root

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1
COPY --from=build /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=build /usr/local/bin /usr/local/bin
COPY . .
EXPOSE 8000
# Поправьте под свой фреймворк: uvicorn для FastAPI, gunicorn для Django.
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
