# Сборка идёт внутри образа, чтобы не зависеть от того, что установлено на машине сборки.
FROM eclipse-temurin:21-jdk AS build
WORKDIR /app
# Сначала только описание зависимостей: слой с их загрузкой переиспользуется,
# пока pom.xml не менялся, и обычная правка кода не тянет их заново.
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN chmod +x ./mvnw && ./mvnw -B dependency:go-offline
COPY src/ src/
RUN ./mvnw -B package -DskipTests

FROM eclipse-temurin:21-jre
WORKDIR /app
# Имя jar заранее неизвестно и зависит от version в pom.xml, поэтому берётся по маске
# и переименовывается: так ENTRYPOINT не нужно править при каждой смене версии.
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
